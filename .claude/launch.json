{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "manhwa-narrator",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "port": 3000
    },
    {
      "name": "manhwa-narrator-3001",
      "runtimeExecutable": "node",
      "runtimeArgs": [
