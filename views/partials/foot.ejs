    </main>
  </div><!-- /.main -->
</div><!-- /.shell -->

<div id="toasts" class="toasts"></div>

<script>
  // ---- Toast notifications (bottom-right, auto-dismiss) ----
  window.toast = function (msg, type) {
    const box = document.getElementById('toasts');
    const t = document.createElement('div');
    t.className = 'toast ' + (type || '');
    t.textContent = msg;
    box.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => {
      t.classList.remove('show');
      setTimeout(() => t.remove(), 300);
    }, 3200);
  };

  // ---- Lightbox: kisi bhi thumbnail par click -> full image ----
  document.addEventListener('click', (e) => {
    const img = e.target.closest('.thumb img');
    if (!img) return;
    const overlay = document.createElement('div');
    overlay.className = 'lightbox';
    overlay.innerHTML = '<img src="' + img.src + '" alt="" /><span class="lightbox-hint">Click anywhere or press Esc to close</span>';
    const close = () => { overlay.remove(); document.removeEventListener('keydown', onKey); };
    const onKey = (ev) => { if (ev.key === 'Escape') close(); };
    overlay.addEventListener('click', close);
    document.addEventListener('keydown', onKey);
    document.body.appendChild(overlay);
  });
</script>
</body>
</html>
