<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="color-scheme" content="dark" />
  <title><%= title %> — Manhwa Narrator</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%237c5cff'/%3E%3Crect x='18' y='14' width='28' height='36' rx='4' fill='white'/%3E%3Crect x='23' y='21' width='18' height='3' rx='1.5' fill='%237c5cff'/%3E%3Crect x='23' y='28' width='18' height='3' rx='1.5' fill='%237c5cff'/%3E%3Crect x='23' y='35' width='12' height='3' rx='1.5' fill='%237c5cff'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/public/style.css" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="shell">
  <aside class="sidebar">
    <a href="/" class="brand"><span class="brand-dot"></span><span class="brand-name">Manhwa Narrator</span></a>

    <nav class="side-nav" aria-label="Main">
      <a href="/" class="side-link <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>" <%- (typeof currentPath !== 'undefined' && currentPath === '/') ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <a href="/settings" class="side-link <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/settings')) ? 'active' : '' %>" <%- (typeof currentPath !== 'undefined' && currentPath.startsWith('/settings')) ? 'aria-current="page"' : '' %>>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        Settings
      </a>
    </nav>

    <% if (typeof sidebarProjects !== 'undefined' && sidebarProjects.length) { %>
      <nav class="side-section" aria-label="Projects">
        <span class="side-label">Projects</span>
        <% sidebarProjects.forEach(function (sp) { %>
          <a href="/projects/<%= sp.id %>" class="side-link side-project <%= (typeof currentPath !== 'undefined' && currentPath.startsWith('/projects/' + sp.id)) ? 'active' : '' %>" title="<%= sp.name %> — <%= sp.chapters.length %> chapter<%= sp.chapters.length === 1 ? '' : 's' %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
            <span class="side-project-name"><%= sp.name %></span>
            <span class="side-count" aria-hidden="true"><%= sp.chapters.length %></span>
          </a>
        <% }) %>
      </nav>
    <% } %>

    <div class="side-foot muted">Manhwa Narrator · v<%= appVersion %></div>
  </aside>

  <div class="main">
    <main class="container" id="main">
