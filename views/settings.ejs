<%- include('partials/head', { title: 'Settings' }) %>

<section class="hero">
  <div>
    <h1>Settings</h1>
    <p class="muted">Google AI (Gemini) API keys, script model and voiceover options.</p>
  </div>
</section>

<% if (saved) { %>
  <div class="alert done" role="status"><i class="ic ic-check-circle" aria-hidden="true"></i><span>Settings saved.</span></div>
<% } %>

<form method="POST" action="/settings" class="card settings-form">
  <label>
    <span>Google AI API Keys <span class="muted">(one key per line — add as many as you want)</span></span>
    <textarea name="apiKeys" rows="4" placeholder="AIza...first-key&#10;AIza...second-key&#10;AIza...third-key" autocomplete="off" spellcheck="false" class="mono"><%= settings.apiKeys %></textarea>
    <small class="muted">
      Get keys from <a href="https://aistudio.google.com/apikey" target="_blank" rel="noopener">Google AI Studio</a> (each Google account gives a separate key).
      <strong>Auto-switch:</strong> when one key hits its daily limit, the app automatically switches to the next key and continues the same job.
      Keys are stored only on your computer.
      <% if (settings.keys.length) { %><br><i class="ic ic-check" aria-hidden="true"></i> <strong><%= settings.keys.length %> key<%= settings.keys.length > 1 ? 's' : '' %></strong> currently set.<% } %>
    </small>
  </label>

  <div class="settings-grid">
    <label>
      <span>Script model</span>
      <select name="model" id="modelSelect">
        <% const modelLabels = { 'gemini-3.8-flash': ' — recommended (FREE)', 'gemini-2.5-flash': ' — backup (FREE)' }; %>
        <% const models = Object.keys(modelLabels); %>
        <% models.forEach(function (m) { %>
          <option value="<%= m %>" <%= settings.model === m ? 'selected' : '' %>><%= m %><%= modelLabels[m] %></option>
        <% }) %>
        <% if (!models.includes(settings.model)) { %>
          <option value="<%= settings.model %>" selected><%= settings.model %> (custom)</option>
        <% } %>
      </select>
      <button type="button" class="btn small load-models" data-target="modelSelect" data-tts="0"><i class="ic ic-refresh" aria-hidden="true"></i>Load models from Google</button>
      <span class="muted models-status small-note" aria-live="polite"></span>
    </label>

    <label>
      <span>Daily Limit <span class="muted">(per key, per day)</span></span>
      <input type="number" name="dailyLimit" value="<%= settings.dailyLimit %>" min="1" max="100000" />
      <small class="muted">Flash models on the free tier ≈ 1000-1500 requests/day per key. This drives the "remaining today" counter on the chapter page.</small>
    </label>
  </div>

  <small class="muted">Both models work on free keys. Pro models (like gemini-3.1-pro-preview) require paid billing — they return 429 on free keys, which is why they're not listed. "Load Models" fetches the live list your key can actually access.</small>

  <!-- ---------- Script policy ---------- -->
  <div class="settings-section">
    <h2><i class="ic ic-shield" aria-hidden="true"></i>Script policy</h2>
    <p class="muted small-note">The base prompt is locked in <code><%= promptFile %></code> (read fresh on every generate). The commentary layer is appended from <code>prompts/commentary-addon.md</code>.</p>
    <label class="toggle">
      <input type="checkbox" name="commentaryMode" value="on" <%= settings.commentaryMode === 'on' ? 'checked' : '' %> />
      <span>Commentary layer ON — hook, narrator's own reactions/analysis every 2-3 images, closing take.</span>
    </label>
    <small class="muted">Why: YouTube's "inauthentic/reused content" rule and 2026 court rulings treat pure retelling as non-transformative. Own-perspective commentary is the single strongest signal of original content. Keep it ON unless you add commentary by hand.</small>
  </div>

  <!-- ---------- Voiceover ---------- -->
  <div class="settings-section">
    <h2><i class="ic ic-mic" aria-hidden="true"></i>Voiceover (Gemini TTS) — one voice file per image</h2>
    <p class="muted small-note">Every <code>--- [IMAGE n] ---</code> section of the script gets its own audio file (<code>image-01.mp3</code>, <code>image-02.mp3</code>…), made with its own TTS request — so each image's voice is exact and can be regenerated alone. Uses the same API keys (with auto-switch); TTS has its own quota, separate from the script model.</p>
    <div class="settings-grid">
      <label>
        <span>TTS model</span>
        <select name="ttsModel" id="ttsModelSelect">
          <% const ttsModels = ['gemini-3.8-flash-tts', 'gemini-3.8-flash-lite-tts', 'gemini-3.1-flash-tts-preview', 'gemini-2.5-flash-preview-tts']; %>
          <% ttsModels.forEach(function (m) { %>
            <option value="<%= m %>" <%= settings.ttsModel === m ? 'selected' : '' %>><%= m %><%= m === 'gemini-3.8-flash-tts' ? ' — recommended' : (m.includes('lite') ? ' — faster/cheaper' : '') %></option>
          <% }) %>
          <% if (!ttsModels.includes(settings.ttsModel)) { %><option value="<%= settings.ttsModel %>" selected><%= settings.ttsModel %> (custom)</option><% } %>
        </select>
        <button type="button" class="btn small load-models" data-target="ttsModelSelect" data-tts="1"><i class="ic ic-refresh" aria-hidden="true"></i>Load TTS models</button>
        <span class="muted models-status small-note" aria-live="polite"></span>
      </label>
      <label>
        <span>TTS daily limit <span class="muted">(per key, per day)</span></span>
        <input type="number" name="ttsDailyLimit" value="<%= settings.ttsDailyLimit %>" min="1" max="100000" />
        <small class="muted">Google's free tier allows <strong>10 TTS requests/day per key</strong> (Oct 2026). <strong>1 image = 1 request</strong>, so a 21-image chapter needs 21 — with 3 keys (~30/day) that is about one chapter a day. If the quota runs out midway, finished images stay saved and the next run only makes the rest.</small>
      </label>
    </div>

    <label>
      <span>Voice <span class="muted">(Google's voices API — new en-US character voices first, then the 30 classic Gemini voices)</span></span>
      <select name="ttsVoice">
        <% const groups = [['character', 'male', 'Character voices (en-US) · male'], ['character', 'female', 'Character voices (en-US) · female'], ['classic', 'male', 'Classic Gemini voices · male'], ['classic', 'female', 'Classic Gemini voices · female'], ['classic', 'neutral', 'Classic Gemini voices · neutral']]; %>
        <% groups.forEach(function (g) { const list = voices.filter(function (v) { return v.kind === g[0] && (v.gender || '') === g[1]; }); if (!list.length) return; %>
          <optgroup label="<%= g[2] %>">
            <% list.forEach(function (v) { %>
              <option value="<%= v.voice %>" <%= settings.ttsVoice === v.voice ? 'selected' : '' %>><%= v.name %><%= v.pitch ? ' · ' + v.pitch + ' pitch' : '' %><%= v.description ? ' — ' + v.description.replace(/\. Recommended.*$/, '').slice(0, 80) : '' %></option>
            <% }) %>
          </optgroup>
        <% }) %>
        <% if (!voices.some(function (v) { return v.voice === settings.ttsVoice; })) { %><option value="<%= settings.ttsVoice %>" selected><%= settings.ttsVoice %> (custom)</option><% } %>
      </select>
      <small class="muted"><strong>Zeno</strong> (<code>en-us-zeno</code>) = male, higher pitch, "cool, confident" reality-TV-star voice. Steadier male options: <strong>Fenrir</strong> (excitable), <strong>Puck</strong> (upbeat), <strong>Charon</strong> (low, steady). Preview in <a href="https://aistudio.google.com/generate-speech" target="_blank" rel="noopener">AI Studio</a>. List saved in <code>lib/voices.json</code>.</small>
    </label>

    <label>
      <span>Delivery style <span class="muted">(sent as style metadata — never spoken aloud; same as AI Studio's style box)</span></span>
      <textarea name="ttsStyle" rows="3" placeholder="Energetic male Hindi YouTube manhwa recap narrator…"><%= settings.ttsStyle %></textarea>
    </label>

    <div class="settings-grid">
      <label>
        <span>Temperature <span class="muted">(0-2)</span></span>
        <input type="number" name="ttsTemperature" value="<%= settings.ttsTemperature %>" min="0" max="2" step="0.05" />
        <small class="muted">Higher = more expressive/varied delivery, lower = flatter and more consistent between images. AI Studio default is 1.0.</small>
      </label>
      <label>
        <span>Language <span class="muted">(BCP-47, blank = auto-detect)</span></span>
        <input type="text" name="ttsLanguage" value="<%= settings.ttsLanguage %>" list="ttsLanguages" placeholder="en-US" />
        <datalist id="ttsLanguages">
          <option value="en-US">English (US)</option>
          <option value="en-IN">English (India)</option>
          <option value="hi-IN">Hindi (India)</option>
          <option value="ur-PK">Urdu (Pakistan)</option>
          <option value="en-GB">English (UK)</option>
        </datalist>
        <small class="muted">AI Studio's "Language" dropdown. Zeno is an <code>en-US</code> voice; for Roman Urdu text keep <code>en-US</code> and let the style text set the Hindi/Urdu accent.</small>
      </label>
    </div>
    <small class="muted">Changing the voice, style, temperature or language makes every image's voice "not generated" again (old files are kept until the next full run finishes).</small>
  </div>

  <div class="actions">
    <button type="submit" class="btn primary lg"><i class="ic ic-save" aria-hidden="true"></i>Save settings</button>
  </div>
</form>

<div class="save-bar hidden" id="saveBar" role="status"><span><i class="ic ic-edit" aria-hidden="true"></i>Unsaved changes</span><button type="button" class="btn primary small" id="saveBarBtn"><i class="ic ic-save" aria-hidden="true"></i>Save settings</button></div>

<!-- ---------- Image Voices card switch (secret number) ---------- -->
<% const voicesOn = settings.showVoicesCard === 'on'; %>
<section class="card settings-form voices-switch-card" id="voices-card">
  <div class="card-head">
    <h2><i class="ic ic-eye" aria-hidden="true"></i>Image Voices card</h2>
    <label class="switch" title="Turn the Image Voices card on/off (asks for your secret number)">
      <input type="checkbox" id="voicesSwitch" <%= voicesOn ? 'checked' : '' %> />
      <span class="slider"></span>
      <span class="switch-label"><%= voicesOn ? 'ON — shown on chapter pages' : 'OFF — hidden' %></span>
    </label>
  </div>
  <p class="muted small-note">Shows or hides the "Image Voices" card (voice generation, clips, ZIP downloads, upload checklist) on every chapter page. Every change asks for your secret number.</p>
  <% if (voicesErr) { %><div class="alert warn" role="alert"><i class="ic ic-x-circle" aria-hidden="true"></i><span><%= voicesErr %></span></div><% } %>
  <% if (voicesMsg) { %><div class="alert done" role="status"><i class="ic ic-check-circle" aria-hidden="true"></i><span><%= voicesMsg %></span></div><% } %>

  <form method="POST" action="/settings/voices-card" class="pin-form <%= voicesErr ? '' : 'hidden' %>" id="pinForm" autocomplete="off">
    <input type="hidden" name="action" value="toggle" />
    <input type="hidden" name="enabled" value="<%= voicesOn ? 'off' : 'on' %>" />
    <% if (settings.hasVoicesPin) { %>
      <label><span>Secret number to turn the card <strong><%= voicesOn ? 'OFF' : 'ON' %></strong></span><input type="password" name="pin" id="pinInput" inputmode="numeric" pattern="\d{4,8}" autocomplete="off" required placeholder="••••" /></label>
    <% } else { %>
      <label><span>Create your secret number <span class="muted">(4-8 digits — first time only)</span></span><input type="password" name="newPin" id="pinInput" inputmode="numeric" pattern="\d{4,8}" autocomplete="new-password" required placeholder="••••" /></label>
      <label><span>Repeat it</span><input type="password" name="newPin2" inputmode="numeric" pattern="\d{4,8}" autocomplete="new-password" required placeholder="••••" /></label>
    <% } %>
    <div class="actions">
      <button type="submit" class="btn primary"><% if (voicesOn) { %><i class="ic ic-eye-off" aria-hidden="true"></i>Turn off (hide card)<% } else { %><i class="ic ic-eye" aria-hidden="true"></i>Turn on (show card)<% } %></button>
      <button type="button" class="btn" id="pinCancel">Cancel</button>
    </div>
  </form>

  <% if (settings.hasVoicesPin) { %>
  <details class="pin-change">
    <summary class="muted small-note">Change secret number</summary>
    <form method="POST" action="/settings/voices-card" class="pin-form" autocomplete="off">
      <input type="hidden" name="action" value="changepin" />
      <label><span>Current</span><input type="password" name="pin" inputmode="numeric" pattern="\d{4,8}" required /></label>
      <label><span>New <span class="muted">(4-8 digits)</span></span><input type="password" name="newPin" inputmode="numeric" pattern="\d{4,8}" required /></label>
      <label><span>Repeat new</span><input type="password" name="newPin2" inputmode="numeric" pattern="\d{4,8}" required /></label>
      <button type="submit" class="btn small">Change</button>
    </form>
  </details>
  <% } %>
</section>
<script>
  // Switch dabao → PIN form khule; asal badlaav server par PIN check ke baad hi hota hai
  (function () {
    const sw = document.getElementById('voicesSwitch');
    const form = document.getElementById('pinForm');
    sw.addEventListener('click', (e) => { e.preventDefault(); form.classList.remove('hidden'); document.getElementById('pinInput').focus(); });
    document.getElementById('pinCancel').addEventListener('click', () => form.classList.add('hidden'));
  })();
</script>

<script>
  document.querySelectorAll('.load-models').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const status = btn.parentElement.querySelector('.models-status');
      const select = document.getElementById(btn.dataset.target);
      status.textContent = 'Loading models from Google…'; status.className = 'muted models-status small-note';
      try {
        const res = await fetch('/api/models' + (btn.dataset.tts === '1' ? '?tts=1' : ''));
        const data = await res.json();
        if (!data.ok) throw new Error(data.error);
        const current = select.value;
        select.innerHTML = '';
        data.models.forEach((m) => {
          const opt = document.createElement('option');
          opt.value = m;
          opt.textContent = m;
          if (m === current) opt.selected = true;
          select.appendChild(opt);
        });
        if (!data.models.includes(current)) {
          const opt = document.createElement('option');
          opt.value = current;
          opt.textContent = current + ' (saved — not in the list!)';
          opt.selected = true;
          select.appendChild(opt);
        }
        status.textContent = 'Found ' + data.models.length + ' models — pick one and save.'; status.className = 'models-status small-note status ok';
      } catch (err) {
        status.textContent = 'Error: ' + err.message; status.className = 'models-status small-note status err';
      }
    });
  });
</script>

<script>
  // Unsaved-changes bar + Ctrl+S — sirf main settings form ke liye
  (function () {
    const form = document.querySelector('form.settings-form'), bar = document.getElementById('saveBar');
    if (!form || !bar) return;
    form.addEventListener('input', () => bar.classList.remove('hidden'));
    document.getElementById('saveBarBtn').addEventListener('click', () => form.requestSubmit());
    document.addEventListener('keydown', (e) => { if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') { e.preventDefault(); form.requestSubmit(); } });
  })();
</script>

<%- include('partials/foot') %>
