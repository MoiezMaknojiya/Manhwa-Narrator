<%- include('partials/head', { title: 'Projects' }) %>

<section class="hero">
  <div>
    <h1>My projects</h1>
    <p class="muted">Create a project, add a chapter, upload its images, get the script and the voices.</p>
  </div>
</section>

<% if (!settings.keys.length) { %>
  <div class="alert warn" role="alert">
    <i class="ic ic-alert" aria-hidden="true"></i>
    <span>No Google AI API key set — add your key(s) in <a href="/settings">Settings</a>, otherwise scripts can't be generated.</span>
  </div>
<% } %>

<form method="POST" action="/projects" class="create-bar">
  <input type="text" name="name" placeholder="New project name — e.g. 'Infinite Level Up in Murim'…" required autofocus aria-label="New project name" />
  <button type="submit" class="btn primary lg"><i class="ic ic-plus" aria-hidden="true"></i>Create project</button>
</form>

<% if (projects.length === 0) { %>
  <div class="empty-state">
    <i class="ic ic-book empty-icon" aria-hidden="true"></i>
    <p>No projects yet — type a series name above and create your first one.</p>
  </div>
<% } else { %>
  <section class="grid" aria-label="Projects">
    <% projects.forEach(function (p) { %>
      <div class="project-card">
        <a href="/projects/<%= p.id %>" class="card-link">
          <h3><%= p.name %></h3>
          <p class="muted"><%= p.chapters.length %> chapter<%= p.chapters.length === 1 ? '' : 's' %></p>
          <span class="card-arrow">Open <i class="ic ic-arrow-right" aria-hidden="true"></i></span>
        </a>
        <form method="POST" action="/projects/<%= p.id %>/delete" data-confirm="Delete the project “<%= p.name %>”? All of its chapters, images, scripts and voices are removed too." data-confirm-title="Delete project" data-confirm-text="Delete project">
          <button type="submit" class="btn icon-only ghost-danger" aria-label="Delete project <%= p.name %>" title="Delete project"><i class="ic ic-trash" aria-hidden="true"></i></button>
        </form>
      </div>
    <% }) %>
  </section>
<% } %>

<%- include('partials/foot') %>
